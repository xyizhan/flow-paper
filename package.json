{
  "name": "flow-paper",
  "version": "0.3.0-beta.2",
  "private": true,
  "description": "A macOS paper reader with contextual AI chat, built on LLM for Zotero and EmbedPDF.",
  "type": "module",
  "main": "dist/main.cjs",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "npm run build && electron .",
    "test": "node --test test/*.test.mjs",
    "test:e2e": "node test/e2e.mjs",
    "package:mac": "node scripts/package-mac.mjs",
    "build:release": "node scripts/build.mjs --release",
    "release:mac": "node scripts/release-mac.mjs",
    "source:archive": "node scripts/source-archive.mjs",
    "audit": "python3 scripts/audit-release.py",
    "verify": "npm run build && npm test && npm run test:e2e"
  },
  "dependencies": {
    "@embedpdf/snippet": "2.15.1",
    "dompurify": "^3.3.0",
    "highlight.js": "^11.11.1",
    "katex": "^0.19.0",
    "marked": "^16.4.2",
    "pdf-lib": "1.17.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "electron": "44.7.0",
    "esbuild": "0.25.12",
    "playwright": "^1.56.0",
    "typescript": "^5.9.3"
  },
  "productName": "Flow Paper",
  "repository": {
    "type": "git",
    "url": "https://github.com/xyizhan/flow-paper.git"
  },
  "homepage": "https://github.com/xyizhan/flow-paper",
  "bugs": {
    "url": "https://github.com/xyizhan/flow-paper/issues"
  },
  "engines": {
    "node": ">=24"
  }
}
